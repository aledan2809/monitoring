# Service Monitor — environment variables
#
# Copy this file to `.env` and fill in real values, OR (preferred for this
# ecosystem) keep the real values in `Master/credentials/monitoring.env` and
# load them from there. NEVER commit a real `.env` — it is gitignored.
#
# The WhatsApp alert channel is OPTIONAL: if these vars are unset the monitor
# still runs and just skips sending alerts (logs a clear "Missing env var"
# message).

# Meta WhatsApp Cloud API — phone number ID (numeric, from Meta Business Manager)
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id

# Meta WhatsApp Cloud API — access token (use a long-lived System User token
# with scope whatsapp_business_messaging). DO NOT put a real token in this file.
WHATSAPP_ACCESS_TOKEN=your_meta_access_token

# Phone number that receives the alerts (E.164 without leading +, e.g. 40712345678)
ALERT_PHONE=your_alert_phone_number
